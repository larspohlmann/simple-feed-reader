# The full ServiceRoleRule report while #1202 lands its roles: `composer roles`. Lists merge with the included file's.
includes:
    - phpstan.dist.neon

parameters:
    serviceRoleChecks:
        - interfaceName
        - interfaceFolder
        - factoryName
        - factoryFolder
        - modelName
        - modelFolder
        - modelShape
        - dtoShape
        - modelHome
        - passHome
        - supportHome
        - rootService
        - statefulService
        - listenerName
        - handlerName
        - supportShape
