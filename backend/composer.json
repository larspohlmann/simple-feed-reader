{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-xmlreader": "*",
        "ext-zlib": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.7",
        "fivefilters/readability.php": "^4.0",
        "lcobucci/jwt": "^5.6",
        "lexik/jwt-authentication-bundle": "^3.2",
        "maennchen/zipstream-php": "^3.2.2",
        "paragonie/constant_time_encoding": "^3.1",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "8.1.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/property-access": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^3.24",
        "twig/twig": "^3.28",
        "web-auth/webauthn-lib": "^5.3.6"
    },
    "require-dev": {
        "ext-openssl": "*",
        "ext-zip": "*",
        "brianium/paratest": "^7.20",
        "dama/doctrine-test-bundle": "^8.6",
        "infection/infection": "^0.34.1",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan": "^2.3.4",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phptramp/phptramp": "dev-develop",
        "phpunit/phpunit": "^12.5.31",
        "squizlabs/php_codesniffer": "^3.13.6",
        "symfony/ai-mate": "^0.13.0",
        "symfony/ai-monolog-mate-extension": "^0.13.0",
        "symfony/ai-symfony-mate-extension": "^0.13.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "infection/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Mate\\": "mate/src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=512M",
        "md": "phpmd analyze src --no-progress",
        "tramp": "phptramp",
        "tramp:update": "composer update phptramp/phptramp --no-interaction --no-progress --no-scripts",
        "check": [
            "@cs",
            "@stan",
            "@tramp"
        ],
        "test": "@php bin/phpunit",
        "test:parallel": "paratest",
        "infection": "infection --threads=max",
        "infection:diff": "infection --git-diff-filter=AM --git-diff-base=origin/develop --threads=max --ignore-msi-with-no-mutations",
        "infection:coverage": "@php -d pcov.enabled=1 vendor/bin/paratest --order-by=random --coverage-xml var/infection-coverage/coverage-xml --log-junit var/infection-coverage/junit.xml",
        "infection:diff:rerun": "infection --git-diff-filter=AM --git-diff-base=origin/develop --threads=max --ignore-msi-with-no-mutations --coverage=var/infection-coverage --skip-initial-tests",
        "e2e": "bin/e2e.sh"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        },
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    }
}
