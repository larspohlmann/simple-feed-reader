{
    $schema: 'vendor/infection/infection/resources/schema.json',
    source: {
        directories: ['src'],
        // The Excimer adapter needs ext-excimer, which the native mutation run
        // lacks; it is covered by the Docker leg's ExcimerSamplerTest instead.
        excludes: ['Service/Profiling/ProfileSampler/ExcimerSampler.php'],
    },
    logs: {
        text: 'var/infection.log',
    },
    // Each ignore names one mutator and one method, for an equivalent mutant, never wholesale: a real mutant in the
    // same method still fails the build.
    mutators: {
        '@default': true,
        // FeedParser::parse(): UnwrapFinally, since the empty-body guard precedes loadXML() and nothing in the try
        // throws; BitwiseOr, since LIBXML_DTDLOAD is off: with the flag mutated to '&',
        // testDoesNotFetchAnExternalDtdOverTheNetwork still sees no connection (measured).
        UnwrapFinally: { ignore: ['App\\Service\\Parser\\FeedParser::parse'] },
        BitwiseOr: { ignore: ['App\\Service\\Parser\\FeedParser::parse'] },
        // CastString, equivalent: SubstackProfileFeed::feedUrl()'s regex refuses null and '' alike, and
        // ClientErrorScrubber::redact()'s preg_replace() returns null only on a PCRE failure its fixed patterns
        // never hit; the cast is for PHPStan.
        CastString: {
            ignore: [
                'App\\Service\\Discovery\\SubstackProfileFeed::feedUrl',
                'App\\Service\\ClientError\\ClientErrorScrubber::redact',
            ],
        },
        // cancel() on a landed response only frees the connection early: against MockHttpClient it has no
        // observable effect, and a spy on it would test the mock.
        MethodCallRemoval: {
            ignore: [
                'App\\Service\\Fetch\\RedirectFollower::redirectTarget',
                'App\\Service\\Reader\\HtmlPageFetcher::fetch',
                'App\\Service\\Reader\\Media\\StreamLocationResolver::landingUrlOf',
            ],
        },
        // content() runs only after fetch() confirmed isSuccess(), and getContent()'s flag differs only on a non-2xx.
        FalseValue: { ignore: ['App\\Service\\Reader\\HtmlPageFetcher::content'] },
        // The 3 MB cap is checked twice, while streaming and after the read: `>` vs `>=` on it is not worth a 3 MB
        // fixture, and dropping the streaming throw leaves the post-read check.
        GreaterThan: {
            ignore: [
                'App\\Service\\Reader\\HtmlPageFetcher::fetch',
                'App\\Service\\Reader\\HtmlPageFetcher::options',
            ],
        },
        Throw_: { ignore: ['App\\Service\\Reader\\HtmlPageFetcher::options'] },
        // EntryMediaAssembler::visualMedia() reads $seen only through isset(), which true and false both satisfy.
        TrueValue: { ignore: ['App\\Service\\Ingest\\Support\\EntryMediaAssembler::visualMedia'] },
        // Cast on (int) $entity->getId() as an array key only narrows ?int for
        // PHPStan; the id is always set, so the key is identical.
        CastInt: {
            ignore: [
                'App\\Controller\\Api\\SavedSearchController::list',
                'App\\Controller\\Api\\SubscriptionController::list',
                'App\\Service\\Search\\SavedSearchTallies::forAll',
                'App\\Service\\Search\\SavedSearchTallies::forOne',
                // MySQL returns COUNT() as numeric string, so cast stays;
                // SQLite returns int.
                'App\\Repository\\SavedSearchEntryRepository::memberCountsBySavedSearch',
                'App\\Repository\\SubscriptionRepository::entryCountsForUser',
            ],
        },
        // Doctrine turns empty IN parameter into always-false predicate,
        // same empty result.
        ReturnRemoval: {
            ignore: [
                'App\\Repository\\FeedRepository::idsByUrlsForUser',
                'App\\Repository\\SavedSearchEntryRepository::memberCountsBySavedSearch',
            ],
        },
        // Guard only runs with [], so slicing changes nothing.
        ArrayOneItem: { ignore: ['App\\Repository\\SavedSearchEntryRepository::memberCountsBySavedSearch'] },
        // A slideshow always has 2+ images, so querySelector('img') never returns
        // null here; the `?->` exists only for PHPStan.
        NullSafeMethodCall: { ignore: ['App\\Service\\Reader\\Slideshow\\SlideshowMarkup::loadFirstSlideEagerly'] },
        // toDto()'s default arm is unreachable: BackupLineOrderModel refuses every other kind first.
        MatchArmRemoval: { ignore: ['App\\Service\\Backup\\BackupReader::toDto'] },
    },
    phpUnit: {
        configDir: '.',
    },
    // A mutant that loops forever has to be cut off, and the cut-off has to sit
    // far enough above a healthy test that a slow runner cannot trip it. The
    // whole suite runs in ~11 s; a single mutant runs a fraction of that.
    timeout: 30,
    // The gate runs against changed files only (see composer infection:diff), so
    // this is the bar for code a branch touches, not for the whole tree. A full
    // sweep scores lower — raise this as the tree catches up, never lower it.
    minMsi: 80,
}
