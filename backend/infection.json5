{
    $schema: 'vendor/infection/infection/resources/schema.json',
    source: {
        directories: ['src'],
    },
    logs: {
        text: 'var/infection.log',
    },
    mutators: {
        '@default': true,
        // Two equivalent mutants in FeedParser::parse(). Both rewrite the code
        // without changing anything it can do, so no honest test kills them, and
        // the only other way to pass the gate for that file would be a test that
        // asserts a difference which does not exist. Each is ignored by name and
        // by method, never wholesale — a real mutant in the same method still
        // fails the build.
        //
        // UnwrapFinally: nothing inside the try can throw. loadXML() raises a
        // ValueError for an empty string only, and the guard above it refuses an
        // empty body first, so the finally never unwinds an exception. It stays
        // as defence for the day that changes.
        //
        // BitwiseOr (LIBXML_NONET | LIBXML_COMPACT): the flag is defence in
        // depth, not the active control. libxml never fetches an external DTD
        // here because LIBXML_DTDLOAD is off — measured, not assumed: with the
        // flag mutated to '&', testDoesNotFetchAnExternalDtdOverTheNetwork still
        // sees no connection.
        UnwrapFinally: { ignore: ['App\\Service\\Parser\\FeedParser::parse'] },
        BitwiseOr: { ignore: ['App\\Service\\Parser\\FeedParser::parse'] },
        // CastString in SubstackProfileFeed::feedUrl(): parse_url returns null
        // for a URL with no path (e.g. https://substack.com), and (string) null
        // is '' — but the profile regex refuses both null and '' identically, so
        // the cast changes nothing the method can do. Equivalent mutant, ignored
        // by name and method; a real mutant in the same method still fails.
        CastString: { ignore: ['App\\Service\\Discovery\\SubstackProfileFeed::feedUrl'] },
        // MethodCallRemoval on a landed response's cancel(): it only releases the
        // underlying connection early once the caller is done with it. Against
        // MockHttpClient that has no observable effect, and a spy asserting the
        // call would test the mock, not behaviour. Ignored by name and method in
        // the three places a landed response is discarded this way.
        MethodCallRemoval: {
            ignore: [
                'App\\Service\\Fetch\\RedirectFollower::redirectTarget',
                'App\\Service\\Reader\\HtmlPageFetcher::fetch',
                'App\\Service\\Reader\\Media\\StreamLocationResolver::landingUrlOf',
            ],
        },
        // FalseValue on HtmlPageFetcher::content()'s getContent(false): the
        // buffer-vs-throw flag only differs on a non-2xx response, but content()
        // runs only after fetch() has already confirmed isSuccess(), so the flag
        // has no reachable effect here.
        FalseValue: { ignore: ['App\\Service\\Reader\\HtmlPageFetcher::content'] },
        // GreaterThan and Throw_ on HtmlPageFetcher's 3 MB byte cap: the post-read
        // check in fetch() and the streaming check in options()'s on_progress
        // closure enforce the same hard limit, the streaming one as
        // defence-in-depth behind the post-read one. The `>` vs `>=` boundary on
        // a fixed 3-million-byte constant is not a behaviour worth a 3 MB test
        // fixture, and Throw_ dropping the streaming throw still leaves the
        // post-read check to catch an oversized body.
        GreaterThan: {
            ignore: [
                'App\\Service\\Reader\\HtmlPageFetcher::fetch',
                'App\\Service\\Reader\\HtmlPageFetcher::options',
            ],
        },
        Throw_: { ignore: ['App\\Service\\Reader\\HtmlPageFetcher::options'] },
    },
    phpUnit: {
        configDir: '.',
    },
    // A mutant that loops forever has to be cut off, and the cut-off has to sit
    // far enough above a healthy test that a slow runner cannot trip it. The
    // whole suite runs in ~11 s; a single mutant runs a fraction of that.
    timeout: 30,
    // The gate runs against changed files only (see composer infection:diff), so
    // this is the bar for code a branch touches, not for the whole tree. A full
    // sweep scores lower — raise this as the tree catches up, never lower it.
    minMsi: 80,
}
