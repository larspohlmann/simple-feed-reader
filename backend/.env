# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_dev.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app/maintenance ###
MAINTENANCE_TOKEN=''
###< app/maintenance ###

###> recommendation drainer (#371) ###
# Absolute path of a CLI-SAPI php binary, used to spawn the detached
# recommendation drainer out of a web request. Leave empty on installs whose
# web PHP already runs the cli SAPI or that have a background worker; on
# Strato this must be /opt/RZphp84/bin/php-cli.
DRAIN_PHP_CLI_BINARY=''
###< recommendation drainer (#371) ###

###> search (#432) ###
# Meilisearch base URL and admin API key. Both empty means every search runs
# against the database instead — the permanent fallback, not a degraded mode.
# The Docker dev stack points these at the meilisearch container via real
# environment variables (Symfony precedence); a native, non-Docker run has no
# Meilisearch to point at, so it always searches the database.
MEILISEARCH_URL=''
MEILISEARCH_KEY=''
###< search (#432) ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=test-passphrase-not-for-production
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Simple Feed Reader"
# Deliberate "no mail" mode for a private instance (issue #230). Empty = mail on.
MAIL_DISABLED=
###< symfony/mailer ###

###> app/auth ###
# Base URL of the SPA; used to build links inside emails.
APP_FRONTEND_URL=http://localhost:4200
# Long random string. Signs ALTCHA challenges.
ALTCHA_HMAC_KEY=test-altcha-hmac-key-not-for-production
###< app/auth ###

# Master secret for sealing per-account AI provider API keys (#305). The
# committed value is a placeholder; scripts/prod-start.sh generates a real one
# on the server, and it never enters git or the database. Changing it makes
# every stored API key unreadable, and each account must enter its key again.
AI_KEY_SECRET=test-ai-key-secret-not-for-production-0123456789

###> app/oauth ###
# Google: OAuth 2.0 Client ID of type "Web application" from the Google Cloud
# console. The redirect URI registered there must be, exactly:
#   <APP_BACKEND_URL>/api/auth/oauth/google/callback
# Leave both blank to disable Google sign-in entirely.
GOOGLE_OAUTH_CLIENT_ID=''
GOOGLE_OAUTH_CLIENT_SECRET=''

# Apple: the Services ID (NOT the App ID) is the client_id. The private key is
# the contents of the .p8 file downloaded once from the Apple developer portal
# — newlines included. Leave APPLE_OAUTH_CLIENT_ID blank to disable Apple.
APPLE_OAUTH_CLIENT_ID=''
APPLE_OAUTH_TEAM_ID=''
APPLE_OAUTH_KEY_ID=''
APPLE_OAUTH_PRIVATE_KEY=''

# Absolute base URL this backend is reachable at, used to build the redirect
# URI handed to the providers. It must match what is registered with them
# byte for byte, so it cannot be derived from the incoming request: a Host
# header an attacker controls would otherwise redirect the code elsewhere.
APP_BACKEND_URL=http://localhost:8000
###< app/oauth ###

###> app/cache ###
# Where the filesystem cache pools (rate limiter, ALTCHA replay, OAuth state
# and login codes) are written, and the namespace their keys live under.
#
# CACHE_DIRECTORY is Symfony's own default, verbatim, so the on-disk location
# is unchanged for the Docker setup and for local development. It resolves
# inside var/cache -- per-release, and wiped by cache:clear -- which is why a
# release-directory deployment MUST point it somewhere shared in .env.local.
#
# CACHE_PREFIX_SEED deliberately does NOT reproduce Symfony's default
# (`_%kernel.project_dir%.%kernel.container_class%`). That default changes
# with the checkout path, so it would keep renaming the namespace on every
# deploy even after CACHE_DIRECTORY is pointed at shared storage. Pinning a
# literal is the only way to get one stable namespace across releases. It
# costs one renamespacing wherever cache data already exists, dropping the
# then-current rate-limit counters and spent ALTCHA solutions -- a cold start
# all four pools tolerate.
CACHE_DIRECTORY=%kernel.share_dir%/pools/app
CACHE_PREFIX_SEED=simple-feed-reader
###< app/cache ###

###> app/update-check (#539) ###
# Which GitHub repository the sidebar's "update available" badge reads its
# releases from. Defaults to this project, so a stock deployment gets the check
# for free; a fork points it at its own repository. Empty turns the check off —
# the API then reports no update and never calls GitHub (the test suite forces
# it empty for exactly that reason).
GITHUB_RELEASE_REPOSITORY=larspohlmann/simple-feed-reader
###< app/update-check (#539) ###

###> app/setup ###
# Set to a high-entropy value (openssl rand -hex 32) ONLY to enable the no-shell
# web setup wizard for the first admin. Leave empty when you bootstrap over a
# shell with `bin/console app:admin:create`. Remove it again after setup.
ADMIN_SETUP_SECRET=
###< app/setup ###
