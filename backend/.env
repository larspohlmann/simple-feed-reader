# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_dev.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app/maintenance ###
MAINTENANCE_TOKEN=''
###< app/maintenance ###

###> app/fetch (#1025) ###
# Feed requests a refresh sweep keeps in flight. Lower it on a host whose PHP
# worker has a memory cap below memory_limit; Strato runs at 3.
FETCH_CONCURRENCY=8
###< app/fetch (#1025) ###

###> recommendation drainer (#371) ###
# CLI-SAPI php binary that spawns the detached recommendation drainer from a web request. Empty where web PHP
# already runs the cli SAPI or a worker runs; on Strato /opt/RZphp84/bin/php-cli.
DRAIN_PHP_CLI_BINARY=''
###< recommendation drainer (#371) ###

###> search (#432) ###
# Meilisearch base URL and admin key. Both empty: every search runs against the database, the permanent fallback.
# The Docker dev stack sets them as real environment variables, which win over this file.
MEILISEARCH_URL=''
MEILISEARCH_KEY=''
###< search (#432) ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=test-passphrase-not-for-production
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=dynamic://default
MAILER_FALLBACK_DSN=null://null
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Simple Feed Reader"
###< symfony/mailer ###

###> app/auth ###
# Base URL of the SPA; used to build links inside emails.
APP_FRONTEND_URL=http://localhost:4200
# Long random string. Signs ALTCHA challenges.
ALTCHA_HMAC_KEY=test-altcha-hmac-key-not-for-production
###< app/auth ###

# Seals each account's AI provider API key. A placeholder: scripts/prod-start.sh generates the real one on the
# server. Changing it makes every stored key unreadable.
INSTANCE_SECRET_KEY=test-ai-key-secret-not-for-production-0123456789

###> app/oauth ###
# Google: a "Web application" OAuth client ID. Its registered redirect URI must be exactly
#   <APP_BACKEND_URL>/api/auth/oauth/google/callback
# Leave both blank to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=''
GOOGLE_OAUTH_CLIENT_SECRET=''

# Apple: the Services ID (NOT the App ID) is the client_id. The private key is
# the contents of the .p8 file downloaded once from the Apple developer portal
# — newlines included. Leave APPLE_OAUTH_CLIENT_ID blank to disable Apple.
APPLE_OAUTH_CLIENT_ID=''
APPLE_OAUTH_TEAM_ID=''
APPLE_OAUTH_KEY_ID=''
APPLE_OAUTH_PRIVATE_KEY=''

# This backend's absolute base URL, for the redirect URI the providers match byte for byte. Never derived from the
# request: an attacker's Host header would send the code elsewhere.
APP_BACKEND_URL=http://localhost:8000
###< app/oauth ###

###> app/cache ###
# Where the filesystem cache pools live, and their key namespace. The default directory sits in var/cache, which
# every release replaces, so a release-directory deploy points it at shared storage. The seed is a literal because
# Symfony's default changes with the checkout path and would rename the namespace on every deploy.
CACHE_DIRECTORY=%kernel.share_dir%/pools/app
CACHE_PREFIX_SEED=simple-feed-reader
###< app/cache ###

###> app/update-check (#539) ###
# The repository the "update available" badge reads releases from; a fork points it at its own. Empty turns the
# check off without calling GitHub (the test suite relies on that).
GITHUB_RELEASE_REPOSITORY=larspohlmann/simple-feed-reader
###< app/update-check (#539) ###

###> app/setup ###
# Set to a high-entropy value (openssl rand -hex 32) ONLY to enable the no-shell
# web setup wizard for the first admin. Leave empty when you bootstrap over a
# shell with `bin/console app:admin:create`. Remove it again after setup.
ADMIN_SETUP_SECRET=
###< app/setup ###

###> app/digest ###
# Timezone the digest send hour is interpreted in. IANA name; default UTC.
APP_TIMEZONE=UTC
###< app/digest ###

###> grafana ###
GRAFANA_LOKI_PUSH_URL=
GRAFANA_URL=
PYROSCOPE_PUSH_URL=
###< grafana ###
