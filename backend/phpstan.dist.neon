includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # Fixtures for ThinControllerRuleTest: deliberate rule violations in the
        # App\Controller namespace, analysed only by the rule's own RuleTestCase.
        - tests/PhpStan/data/*
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

services:
    -
        class: App\Tests\PhpStan\ThinControllerRule
        tags:
            - phpstan.rules.rule
