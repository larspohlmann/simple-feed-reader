includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parametersSchema:
    # ServiceRoleRule's enforced checks; phpstan-service-roles.neon lists every one (#1202).
    serviceRoleChecks: listOf(string())

parameters:
    level: max
    serviceRoleChecks:
        - interfaceName
        - interfaceFolder
        - factoryName
        - factoryFolder
        - modelName
        - modelShape
        - modelFolder
        - dtoShape
    paths:
        - src
        - tests
    scanDirectories:
        # Symbols only, not analysed: lets a test resolve a migration class.
        - migrations
    excludePaths:
        # Deliberate custom-rule violations, analysed only by each rule's RuleTestCase.
        - tests/PhpStan/data/*
    stubFiles:
        # ext-excimer is absent on the native/CI PHP that runs PHPStan.
        - tests/PhpStan/stubs/excimer.stub
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

services:
    -
        class: App\Tests\PhpStan\ChainedNullCoalescingRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\ThinControllerRule
        tags:
            - phpstan.rules.rule
    -
        class: PhpParser\NodeFinder
    -
        class: App\Tests\PhpStan\DomainKnowsNoHttpRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\NoToArrayInServicesRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\PersistenceKnowsNoServiceRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\EntityIdCoercionRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\QueriesLiveInRepositoriesRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\ControllerEntityUse
    -
        class: App\Tests\PhpStan\ControllerMutatesNoEntityRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\ControllerMutatesNoEntityThroughMethodCallableRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\ControllerMutatesNoEntityThroughStaticCallableRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\ServiceModuleDependencyCollector
        tags:
            - phpstan.collector
    -
        class: App\Tests\PhpStan\ServiceModuleCycleRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\ServiceModuleBoundaryRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\ServiceRoleClassCollector
        tags:
            - phpstan.collector
    -
        class: App\Tests\PhpStan\ServiceRoleInstantiationCollector
        tags:
            - phpstan.collector
    -
        class: App\Tests\PhpStan\ServiceRoleRule
        arguments:
            checks: %serviceRoleChecks%
        tags:
            - phpstan.rules.rule
