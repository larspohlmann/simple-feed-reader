includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # Deliberate custom-rule violations, analysed only by each rule's RuleTestCase.
        - tests/PhpStan/data/*
    stubFiles:
        # ext-excimer is absent on the native/CI PHP that runs PHPStan.
        - tests/PhpStan/stubs/excimer.stub
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

services:
    -
        class: App\Tests\PhpStan\ChainedNullCoalescingRule
        tags:
            - phpstan.rules.rule
    -
        class: App\Tests\PhpStan\ThinControllerRule
        tags:
            - phpstan.rules.rule
    -
        class: PhpParser\NodeFinder
    -
        class: App\Tests\PhpStan\DomainKnowsNoHttpRule
        tags:
            - phpstan.rules.rule
