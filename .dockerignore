# Keep build contexts small and secrets out of images. Both the php and the
# web image build from the repo root (they must see backend/ and frontend/).
.git
.idea
.claude
.superpowers
.playwright-mcp
docs
deploy
scripts
.github
# ...except the one build helper both image builds run to stamp the release
# version into the SPA's version.ts and the backend's version.json (issue #500).
!scripts/stamp-version.sh

# Local TLS material and operator secrets must never enter an image.
docker/certs
docker/certs-prod
.env.prod
backend/config/jwt
backend/.env.local
backend/.env.*.local
backend/config/secrets

# Host-side build products; the images install/build their own.
backend/var
backend/vendor
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
